# Copy to .env for local configuration if needed.
# Generate a strong secret key before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Local development defaults to SQLite if DATABASE_URL is unset.
# For production, set DATABASE_URL to your PostgreSQL connection string.
DATABASE_URL=
# Used only with the Flask CLI command: flask --app app create-admin
ADMIN_USERNAME=schooladmin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
